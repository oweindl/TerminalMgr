<Project>
  <!-- The one place that holds the version: Major.Minor. The patch number is the run number of the build workflow, which passes
       -p:Version=Major.Minor.N for a release; local builds are Major.Minor.0. -->
  <PropertyGroup>
    <MajorMinor>0.2</MajorMinor>
    <Version Condition="'$(Version)' == ''">$(MajorMinor).0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Product>TerminalMgr</Product>
  </PropertyGroup>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
