<Window x:Class="TerminalMgr.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" Icon="Assets/TerminalMgr.ico" Title="TerminalMgr" Width="1480" Height="940" MinWidth="880" MinHeight="540" Loaded="WindowLoaded" SourceInitialized="WindowSourceInitialized" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
 <Window.Resources>
  <Style x:Key="ClipActionButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
   <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
  </Style>
  <Style x:Key="ClipPinFilter" TargetType="ToggleButton">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="6,0,0,0"/>
   <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Filter" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Filter" Property="Background" Value="{DynamicResource AccentTintBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Filter" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Filter" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Filter" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <!-- Direction C "Commander": icon bar | server panel (opens from the bar) | session tabs + terminal | right column with clipboard and dictation. -->
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="56"/>
   <ColumnDefinition x:Name="ServerColumn" Width="0" MinWidth="0"/>
   <ColumnDefinition x:Name="ServerSplitterColumn" Width="0"/>
   <ColumnDefinition Width="*" MinWidth="300"/>
   <ColumnDefinition x:Name="ClipboardSplitterColumn" Width="4"/>
   <ColumnDefinition x:Name="ClipboardColumn" Width="312" MinWidth="0"/>
  </Grid.ColumnDefinitions>

  <!-- Icon bar -->
  <Border Grid.Column="0" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10">
     <Button Style="{StaticResource FlatButton}" Click="ToggleFocus" ToolTip="Fokusmodus: Seitenbereiche ausblenden" AutomationProperties.Name="Fokusmodus" Width="40" Height="40" Margin="0,3">
      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFocus}"/>
     </Button>
     <ToggleButton x:Name="SettingsButton" Style="{StaticResource IconBarButton}" Click="OpenSettings" ToolTip="Einstellungen" AutomationProperties.Name="Einstellungen">
      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSettings}"/>
     </ToggleButton>
    </StackPanel>
    <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0">
     <Image Source="Assets/TerminalMgr.png" Width="30" Height="30" Margin="0,0,0,14" ToolTip="TerminalMgr"/>
     <ToggleButton x:Name="ServerButton" Style="{StaticResource IconBarButton}" Click="ToggleServerPanel" ToolTip="Server: Liste auf- und zuklappen" AutomationProperties.Name="Server">
      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconServer}"/>
     </ToggleButton>
     <ToggleButton x:Name="ClipboardButton" Style="{StaticResource IconBarButton}" Click="ToggleClipboard" ToolTip="Clipboard: rechte Spalte ein- und ausblenden" AutomationProperties.Name="Clipboard" IsChecked="True">
      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconClipboard}"/>
     </ToggleButton>
     <ToggleButton x:Name="DictationButton" Style="{StaticResource IconBarButton}" Click="DictationButtonClick" ToolTip="Diktat starten (Ctrl+Y)" AutomationProperties.Name="Diktat">
      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMic}"/>
     </ToggleButton>
     <ToggleButton x:Name="StripButton" Style="{StaticResource IconBarButton}" Click="ToggleStrip" ToolTip="Fensterleiste: tmux-Fenster mit Status ein- und ausblenden" AutomationProperties.Name="Fensterleiste" IsChecked="True">
      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconStrip}"/>
     </ToggleButton>
    </StackPanel>
   </DockPanel>
  </Border>

  <!-- Server panel: status, tmux sessions and windows (right click) as before -->
  <DockPanel x:Name="ServerPanel" Grid.Column="1" Visibility="Collapsed" Background="{DynamicResource BarBrush}">
   <StackPanel DockPanel.Dock="Top" Margin="12,14,12,8">
    <TextBlock Text="SERVER" Foreground="{DynamicResource Text2Brush}" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,8"/>
    <WrapPanel>
     <Button Content="+ Profil" Click="AddProfile" Margin="0,3,6,3"/>
     <Button Content="Import" Click="ImportProfiles" ToolTip="OpenSSH-Konfiguration importieren" Margin="0,3,0,3"/>
    </WrapPanel>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
    <WrapPanel>
     <Button x:Name="ConnectButton" Content="Verbinden" Click="ConnectSelected" Margin="0,3,6,3"/>
     <Button x:Name="DisconnectButton" Content="Trennen" Click="DisconnectSelected" Margin="0,3,6,3"/>
     <Button Content="Profil …" Click="EditProfile" Margin="0,3,0,3"/>
    </WrapPanel>
    <Button Content="Autostart-Profile verbinden" Click="ConnectAutomatic" Margin="0,3"/>
    <TextBlock x:Name="SessionHint" Text="Alt+1 … Alt+9 · Session wechseln" FontSize="11" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="2,8,0,0"/>
   </StackPanel>
   <ListBox x:Name="ProfilesList" SelectionChanged="ProfileSelected" MouseDoubleClick="ProfileDoubleClick" PreviewMouseRightButtonUp="ServerRightClick">
    <ListBox.ItemTemplate><DataTemplate>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Grid.Column="2" Visibility="{Binding AltVisibility}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="5,0" VerticalAlignment="Top" Margin="6,2,0,0" ToolTip="Mit dieser Taste zu diesem Server wechseln">
       <TextBlock Text="{Binding AltLabel}" FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="{DynamicResource Text2Brush}"/>
      </Border>
      <Ellipse x:Name="Dot" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" Fill="Transparent" Stroke="{DynamicResource LineStrongBrush}" StrokeThickness="1.5"/>
      <StackPanel Grid.Column="1">
       <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Text2Brush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </Grid>
     <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Connection}" Value="Connected"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ConnectedBrush}"/><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource ConnectedBrush}"/></DataTrigger>
      <DataTrigger Binding="{Binding Connection}" Value="Connecting"><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AccentBrush}"/></DataTrigger>
     </DataTemplate.Triggers>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel>
  <GridSplitter x:Name="ServerSplitter" Grid.Column="2" Width="4" Visibility="Collapsed" HorizontalAlignment="Stretch" Background="{DynamicResource LineBrush}"/>

  <!-- Session tabs and terminal -->
  <Grid Grid.Column="3">
   <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
    <DockPanel>
     <Grid>
     <ListBox x:Name="WindowStrip" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="8,7,8,7" Focusable="False" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" AutomationProperties.Name="tmux-Fenster">
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <Border x:Name="Card" Width="176" Margin="0,0,6,0" Padding="9,6,9,6" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource RaisedBrush}" Cursor="Hand" ToolTip="{Binding Tooltip}" Tag="{Binding}" MouseLeftButtonUp="StripCardClick">
        <StackPanel>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center"><TextBlock Text="{Binding Shortcut}" FontFamily="{DynamicResource MonoFont}" FontSize="10" Foreground="{DynamicResource Text2Brush}"/></Border>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
           <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{Binding StateBrush}" Margin="6,0,4,0"/>
           <TextBlock Text="{Binding StateLabel}" FontSize="10" Foreground="{DynamicResource Text2Brush}"/>
          </StackPanel>
         </Grid>
         <StackPanel Margin="0,5,0,0" Height="28">
          <TextBlock Text="{Binding Preview1}" FontFamily="{DynamicResource MonoFont}" FontSize="9.5" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Preview2}" FontFamily="{DynamicResource MonoFont}" FontSize="9.5" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
         <ItemsControl ItemsSource="{Binding SparkHeights}" Height="12" Margin="0,4,0,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><Border Height="{Binding}" Margin="0.75,0" VerticalAlignment="Bottom" CornerRadius="1" Background="{Binding DataContext.StateBrush, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Opacity="0.85"/></DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
        </StackPanel>
       </Border>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Current}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Card" Property="Background" Value="{DynamicResource ActiveTintBrush}"/></DataTrigger>
        <Trigger SourceName="Card" Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Text2Brush}"/></Trigger>
        <DataTrigger Binding="{Binding State}" Value="Running"><DataTrigger.EnterActions><BeginStoryboard x:Name="Pulse"><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetName="StateDot" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.7"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions><DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Pulse"/></DataTrigger.ExitActions></DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <ListBox x:Name="SessionTabs" SelectionChanged="TabSelected" PreviewMouseRightButtonUp="TabRightClick" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" AutomationProperties.Name="Sessions">
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="16,0"/><Setter Property="Margin" Value="0"/><Setter Property="Height" Value="43"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="Tab" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="{TemplateBinding Padding}">
     <Grid>
           <Rectangle x:Name="Top" Height="2" VerticalAlignment="Top" Fill="Transparent" Margin="-16,0"/>
           <ContentPresenter VerticalAlignment="Center"/>
          </Grid>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource BgBrush}"/><Setter TargetName="Top" Property="Fill" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource RaisedBrush}"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Tab" Property="Background" Value="{DynamicResource BgBrush}"/></MultiTrigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
        <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,8,0" Fill="Transparent" Stroke="Transparent" StrokeThickness="1.5"/>
        <TextBlock Text="{Binding Item.Name}" FontWeight="Medium" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Text2Brush}" FontSize="11" Margin="8,2,0,0" VerticalAlignment="Center"/>
       </StackPanel>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Item.Connection}" Value="Connected"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ConnectedBrush}"/><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource ConnectedBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Item.Connection}" Value="Connecting"><Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AccentBrush}"/></DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     </Grid>
    </DockPanel>
   </Border>
   <wv:WebView2 x:Name="TerminalView" Grid.Row="1" DefaultBackgroundColor="#0E0F11"/>
   <Border x:Name="LoadingOverlay" Grid.Row="1" Background="{DynamicResource BgBrush}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
     <TextBlock Text="Deine Server. Ein Arbeitsplatz." FontSize="26" FontWeight="SemiBold" Margin="0,0,0,15"/>
     <TextBlock x:Name="LoadingText" Text="Terminal wird vorbereitet …" TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}"/>
    </StackPanel>
   </Border>
  </Grid>

  <!-- Messages (formerly the status bar) appear as a toast in the terminal page; these text blocks keep the values for the code. -->
  <StackPanel Visibility="Collapsed">
   <TextBlock x:Name="StatusText" Text="Bereit"/>
   <TextBlock x:Name="DimensionsText" Text="Ctrl+B → tmux"/>
   <TextBlock x:Name="SessionTitle" Text="Bereit"/>
  </StackPanel>

  <GridSplitter x:Name="ClipboardSplitter" Grid.Column="4" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource LineBrush}"/>

  <!-- Right column: clipboard, dictation below -->
  <DockPanel x:Name="ClipboardPanel" Grid.Column="5" Background="{DynamicResource BarBrush}">
   <StackPanel x:Name="ClipboardHeader" DockPanel.Dock="Top" Margin="12,10,12,6">
    <DockPanel LastChildFill="True">
     <Button DockPanel.Dock="Right" Content="⋯" Click="ClipboardHistoryMenu" Style="{StaticResource ClipActionButton}" ToolTip="Clipboard-Aktionen" AutomationProperties.Name="Clipboard-Aktionen"/>
     <Button DockPanel.Dock="Right" Style="{StaticResource ClipActionButton}" Click="FontLarger" ToolTip="Schrift vergrößern" AutomationProperties.Name="Schrift vergrößern" Content="A+" FontWeight="SemiBold"/>
     <Button DockPanel.Dock="Right" Style="{StaticResource ClipActionButton}" Click="FontSmaller" ToolTip="Schrift verkleinern" AutomationProperties.Name="Schrift verkleinern" Content="A−" FontWeight="SemiBold"/>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="CLIPBOARD" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}"/>
      <TextBlock x:Name="ClipCount" Text="0" FontSize="11" Foreground="{DynamicResource Text2Brush}" Margin="8,1,0,0"/>
     </StackPanel>
    </DockPanel>
    <Button Click="OpenPaletteClick" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left" Margin="0,6,0,0" Padding="8,5" ToolTip="Befehlspalette: Fenster, Favoriten, Clipboard und Aktionen finden" AutomationProperties.Name="Alles finden">
     <StackPanel Orientation="Horizontal"><TextBlock Text="🔍" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource Text2Brush}"/><TextBlock x:Name="TabHint" Text="Ctrl+Shift+K alles finden" Foreground="{DynamicResource Text2Brush}" FontSize="12"/></StackPanel>
    </Button>
    <DockPanel Margin="0,6,0,0">
     <ToggleButton x:Name="PinnedOnly" DockPanel.Dock="Right" Style="{StaticResource ClipPinFilter}" Checked="FilterClips" Unchecked="FilterClips" ToolTip="Nur angeheftete Einträge" AutomationProperties.Name="Nur angeheftete Einträge">
      <Path Data="M9,3 H15 M10,3 V9 L7,13 V15 H17 V13 L14,9 V3 M12,15 V21" Style="{StaticResource IconPath}" Width="15" Height="15"/>
     </ToggleButton>
     <Grid>
      <TextBox x:Name="ClipSearch" TextChanged="FilterClips" Margin="0" Height="30" Padding="8,5" ToolTip="Text oder Herkunft durchsuchen" AutomationProperties.Name="Clipboard durchsuchen"/>
      <TextBlock Text="Durchsuchen …" Margin="9,0" VerticalAlignment="Center" Foreground="{DynamicResource Text2Brush}" IsHitTestVisible="False">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ClipSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
    </DockPanel>
    <TextBlock Text="Doppelklick zum Einfügen" Foreground="{DynamicResource Text2Brush}" FontSize="10" Margin="1,6,0,0" ToolTip="Klick: aktiv / Volltext · Doppelklick: einfügen · Rechtsklick: Aktionen · Ziehen: ins Terminal übernehmen"/>
   </StackPanel>
   <!-- Dictation under the list: at most a third of the window (MainWindow.Dictation.cs), the text scrolls to the newest words. -->
   <Border x:Name="DictationPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,10">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel>
      <TextBlock x:Name="DictationStatus" DockPanel.Dock="Right" Foreground="{DynamicResource Text2Brush}" Text="Bereit" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center"/>
      <ProgressBar x:Name="DictationLevel" DockPanel.Dock="Right" Width="60" Height="8" Margin="8,0" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BgBrush}" BorderThickness="0" ToolTip="Mikrofonpegel"/>
      <Ellipse x:Name="DictationDot" DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,8,0" Fill="{DynamicResource RecordingBrush}" Visibility="Collapsed"/>
      <TextBlock x:Name="DictationTitle" FontWeight="SemiBold" Text="Diktat" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     </DockPanel>
     <StackPanel x:Name="DictationDownload" Grid.Row="1" Visibility="Collapsed" Margin="0,6,0,0">
      <TextBlock x:Name="DictationDownloadText" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
      <DockPanel><Button DockPanel.Dock="Right" Content="Abbrechen" Click="DictationDownloadCancel"/><ProgressBar x:Name="DictationDownloadBar" Height="10" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BgBrush}" BorderThickness="0"/></DockPanel>
     </StackPanel>
     <ScrollViewer x:Name="DictationScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,4">
      <StackPanel>
       <TextBox x:Name="DictationBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" FontFamily="{DynamicResource MonoFont}" FontSize="13" PreviewKeyDown="DictationBoxKeyDown" TextChanged="DictationBoxChanged" AutomationProperties.Name="Diktiertext"/>
       <TextBlock x:Name="DictationPartial" Visibility="Collapsed" FontStyle="Italic" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" Margin="2,4,0,2" ToolTip="Vorläufiger Zwischenstand: fest = bestätigt, kursiv = kann sich noch ändern"/>
      </StackPanel>
     </ScrollViewer>
     <StackPanel Grid.Row="3">
      <WrapPanel>
       <Button x:Name="DictationRecordButton" Content="● Aufnahme" Click="DictationRecordClick" ToolTip="Aufnahme starten oder stoppen (Diktat-Tastenkürzel)"/>
       <Button Content="Einfügen ↵" Style="{StaticResource PrimaryButton}" Click="DictationInsert" ToolTip="Enter"/>
       <Button Content="+ Enter ⌃↵" Click="DictationInsertRun" ToolTip="Einfügen und ausführen (Ctrl+Enter)"/>
       <Button Content="Esc" Click="DictationDiscard" ToolTip="Verwerfen (Esc)"/>
      </WrapPanel>
      <TextBlock Text="Enter einfügen · Ctrl+Enter einfügen + ausführen · Shift+Enter Zeilenumbruch · Esc verwerfen" Foreground="{DynamicResource Text2Brush}" FontSize="11" TextWrapping="Wrap" Margin="2,2,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <ListBox x:Name="ClipsList" SelectionChanged="ClipSelected" MouseDoubleClick="ClipDoubleClick" VirtualizingPanel.ScrollUnit="Pixel">
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0"/></Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate>
     <Border x:Name="Card" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="10,8,12,8" PreviewMouseLeftButtonDown="ClipPressed" MouseMove="DragClip" MouseEnter="ClipEnter" MouseLeave="ClipLeave" ContextMenuOpening="ClipContextMenuOpening">
      <Border.ContextMenu><ContextMenu/></Border.ContextMenu>
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Visibility="{Binding CollapsedVisibility}" Margin="0,0,24,0">
        <TextBlock Text="{Binding Line1}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Line2}" Visibility="{Binding Line2Visibility}" FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <TextBox Text="{Binding FullText, Mode=OneWay}" Visibility="{Binding ExpandedVisibility}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="12" Padding="0" Margin="0,0,24,0" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
       <Button x:Name="ClipActions" Content="⋯" Click="ClipMenuClick" Tag="{Binding}" Style="{StaticResource ClipActionButton}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-3,-4,0" Opacity="0" IsHitTestVisible="False" ToolTip="Einfügen, kopieren, anheften …" AutomationProperties.Name="Eintragsaktionen"/>
       <Grid Grid.Row="1" Margin="0,5,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Path Visibility="{Binding PinnedVisibility}" Data="M9,3 H15 M10,3 V9 L7,13 V15 H17 V13 L14,9 V3 M12,15 V21" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Stretch="Uniform" Width="10" Height="12" Margin="0,0,6,0" ToolTip="Angeheftet"/>
        <TextBlock Grid.Column="1" Text="{Binding Source}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text2Brush}" FontSize="10" ToolTip="{Binding Source}"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
         <TextBlock Text="{Binding LengthLabel}" Visibility="{Binding LengthVisibility}" Foreground="{DynamicResource Text2Brush}" FontSize="10" Margin="6,0,8,0"/>
         <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Text2Brush}" FontSize="10"/>
        </StackPanel>
       </Grid>
       <!-- Visible frame while the pointer is over the entry; the active entry keeps its accent strip and tint, so the two stay apart. -->
       <Border x:Name="HoverFrame" Grid.RowSpan="2" Margin="-9,-7,-11,-7" BorderThickness="1" CornerRadius="3" BorderBrush="Transparent" IsHitTestVisible="False"/>
      </Grid>
     </Border>
     <DataTemplate.Triggers>
      <Trigger SourceName="Card" Property="IsMouseOver" Value="True"><Setter TargetName="HoverFrame" Property="BorderBrush" Value="{DynamicResource Text2Brush}"/></Trigger>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger>
