<Window x:Class="TerminalMgr.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Foreground="#E2E8ED" Background="#10151A" Icon="Assets/TerminalMgr.ico" Title="TerminalMgr" Width="1480" Height="940" MinWidth="880" MinHeight="540" Loaded="WindowLoaded" SourceInitialized="WindowSourceInitialized" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="#171D23" BorderBrush="#2C3841" BorderThickness="0,0,0,1">
   <DockPanel Margin="16,0">
    <StackPanel Orientation="Horizontal"><Image Source="Assets/TerminalMgr.png" Width="30" Height="30" Margin="0,0,10,0"/><TextBlock Text="TerminalMgr" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="−" Click="FontSmaller" ToolTip="Schrift verkleinern"/>
     <Button Content="+" Click="FontLarger" ToolTip="Schrift vergrößern"/>
     <Button Content="Clipboard" Click="ToggleClipboard"/>
     <Button Content="Einstellungen" Click="OpenSettings"/>
     <Button Content="Fokus" Click="ToggleFocus" ToolTip="Seitenbereiche ausblenden"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="ServerColumn" Width="220" MinWidth="0"/><ColumnDefinition x:Name="ServerSplitterColumn" Width="4"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition x:Name="ClipboardSplitterColumn" Width="4"/><ColumnDefinition x:Name="ClipboardColumn" Width="300" MinWidth="0"/></Grid.ColumnDefinitions>
   <DockPanel x:Name="ServerPanel" Background="#171D23">
    <StackPanel DockPanel.Dock="Top" Margin="10,12,10,8">
     <TextBlock Text="SESSIONS" Foreground="#91A5B4" FontSize="11" Margin="6,0,0,8"/>
     <WrapPanel><Button Content="+ Profil" Click="AddProfile"/><Button Content="Import" Click="ImportProfiles" ToolTip="OpenSSH-Konfiguration importieren"/></WrapPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="10">
     <Button Content="Autostart-Profile verbinden" Click="ConnectAutomatic"/>
     <TextBlock x:Name="SessionHint" Text="Alt+1 … Alt+9 · Session wechseln" FontSize="11" Foreground="#91A5B4" TextWrapping="Wrap" Margin="6,8"/>
    </StackPanel>
    <ListBox x:Name="ProfilesList" SelectionChanged="ProfileSelected" MouseDoubleClick="ProfileDoubleClick" PreviewMouseRightButtonUp="ServerRightClick">
     <ListBox.ItemTemplate><DataTemplate><StackPanel>
      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#91A5B4" Margin="0,5,0,0"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <GridSplitter x:Name="ServerSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#2B3740"/>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#131A20" BorderBrush="#2B3740" BorderThickness="0,0,0,1">
     <DockPanel Margin="12,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
       <Button x:Name="ConnectButton" Content="Verbinden" Click="ConnectSelected"/>
       <Button x:Name="DisconnectButton" Content="Trennen" Click="DisconnectSelected"/>
       <Button Content="Profil …" Click="EditProfile"/>
      </StackPanel>
      <TextBlock x:Name="SessionTitle" Text="Bereit" VerticalAlignment="Center" Foreground="#BBD0DB" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
    </Border>
    <wv:WebView2 x:Name="TerminalView" Grid.Row="1" DefaultBackgroundColor="#0B1014"/>
    <Border x:Name="LoadingOverlay" Grid.Row="1" Background="#0B1014">
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
      <TextBlock Text="Deine Server. Ein Arbeitsplatz." FontSize="26" FontWeight="SemiBold" Margin="0,0,0,15"/>
      <TextBlock x:Name="LoadingText" Text="Terminal wird vorbereitet …" TextWrapping="Wrap" Foreground="#91A5B4"/>
     </StackPanel>
    </Border>
    <StackPanel Grid.Row="2">
     <Border x:Name="DictationPanel" Visibility="Collapsed" Background="#131A20" BorderBrush="#2B3740" BorderThickness="0,1,0,0" Padding="14,10">
      <StackPanel>
       <DockPanel>
        <TextBlock x:Name="DictationStatus" DockPanel.Dock="Right" Foreground="#91A5B4" Text="Bereit"/>
        <ProgressBar x:Name="DictationLevel" DockPanel.Dock="Right" Width="120" Height="8" Margin="12,0" Minimum="0" Maximum="100" Foreground="#43D4B7" Background="#202A32" BorderThickness="0" ToolTip="Mikrofonpegel"/>
        <TextBlock x:Name="DictationTitle" FontWeight="SemiBold" Text="Diktat" TextTrimming="CharacterEllipsis"/>
       </DockPanel>
       <TextBox x:Name="DictationBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="170" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="13" PreviewKeyDown="DictationBoxKeyDown" Margin="0,8,0,4"/>
       <TextBlock x:Name="DictationPartial" Visibility="Collapsed" FontStyle="Italic" Foreground="#7F93A1" TextWrapping="Wrap" Margin="2,0,0,6" ToolTip="Vorläufiger Zwischenstand"/>
       <StackPanel x:Name="DictationDownload" Visibility="Collapsed" Margin="0,4,0,8">
        <TextBlock x:Name="DictationDownloadText" Foreground="#BBD0DB" Margin="0,0,0,4"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="Abbrechen" Click="DictationDownloadCancel"/><ProgressBar x:Name="DictationDownloadBar" Height="10" Minimum="0" Maximum="100" Foreground="#43D4B7" Background="#202A32" BorderThickness="0"/></DockPanel>
       </StackPanel>
       <WrapPanel>
        <Button x:Name="DictationRecordButton" Content="● Aufnahme" Click="DictationRecordClick" ToolTip="Aufnahme starten oder stoppen (Diktat-Tastenkürzel)"/>
        <Button Content="Einfügen" Click="DictationInsert" ToolTip="Enter"/>
        <Button Content="Einfügen + Ausführen" Click="DictationInsertRun" ToolTip="Ctrl+Enter"/>
        <Button Content="Verwerfen" Click="DictationDiscard" ToolTip="Esc"/>
        <TextBlock Text="Enter einfügen · Ctrl+Enter einfügen + ausführen · Shift+Enter Zeilenumbruch · Esc verwerfen" Foreground="#637D8B" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
       </WrapPanel>
      </StackPanel>
     </Border>
     <Border Background="#131A20" BorderBrush="#2B3740" BorderThickness="0,1,0,0" Height="38">
      <Button x:Name="DictationButton" Content="🎤 Diktat" Click="DictationButtonClick" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Diktat starten (Ctrl+Y)"/>
     </Border>
    </StackPanel>
   </Grid>
   <GridSplitter x:Name="ClipboardSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#2B3740"/>
   <DockPanel x:Name="ClipboardPanel" Grid.Column="4" Background="#171D23">
    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,8">
     <TextBlock Text="Clipboard" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TextBox x:Name="ClipSearch" TextChanged="FilterClips" ToolTip="Einträge durchsuchen"/>
     <WrapPanel><Button Content="Leeren" Click="ClearClipboardHistory"/></WrapPanel>
     <CheckBox x:Name="PinnedOnly" Content="Nur angeheftete Einträge" Checked="FilterClips" Unchecked="FilterClips"/>
     <TextBlock Text="Klick: aktiv · Doppelklick: einfügen · Rechtsklick im Terminal: kopieren bzw. aktiven Eintrag einfügen" Foreground="#91A5B4" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
    <ListBox x:Name="ClipsList" SelectionChanged="ClipSelected" MouseDoubleClick="ClipDoubleClick" VirtualizingPanel.ScrollUnit="Pixel">
     <ListBox.ItemTemplate><DataTemplate>
      <Border x:Name="Card" Background="#202A32" CornerRadius="6" Padding="10" BorderThickness="2" BorderBrush="Transparent" PreviewMouseLeftButtonDown="ClipPressed" MouseMove="DragClip" MouseEnter="ClipEnter" MouseLeave="ClipLeave">
       <StackPanel>
        <DockPanel><TextBlock Text="{Binding Source}" Foreground="#43D4B7"/><TextBlock Text="{Binding Time}" Foreground="#91A5B4" HorizontalAlignment="Right"/></DockPanel>
        <StackPanel Visibility="{Binding CollapsedVisibility}">
         <TextBlock Text="{Binding Line1}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
         <TextBlock Text="{Binding Line2}" Visibility="{Binding Line2Visibility}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding LengthLabel}" Visibility="{Binding LengthVisibility}" Foreground="#91A5B4" FontSize="10" Margin="0,4,0,0"/>
        </StackPanel>
        <!-- Unfolded: the full text, about 15 lines, scrollable inside the entry; selectable and copyable. -->
        <TextBox Text="{Binding FullText, Mode=OneWay}" Visibility="{Binding ExpandedVisibility}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" Foreground="#E2E8ED" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="0" Margin="0,8,0,0" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
        <WrapPanel Margin="0,6,0,0"><Button Content="Einfügen" Click="PasteClip" Tag="{Binding}"/><Button Content="{Binding PinLabel}" Click="PinClip" Tag="{Binding}"/><Button Content="×" Click="RemoveClip" Tag="{Binding}" ToolTip="Eintrag entfernen"/></WrapPanel>
       </StackPanel>
      </Border>
      <DataTemplate.Triggers>
       <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#43D4B7"/><Setter TargetName="Card" Property="Background" Value="#21453F"/></DataTrigger>
      </DataTemplate.Triggers>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Grid>
  <Border Grid.Row="2" Background="#171D23" BorderBrush="#2B3740" BorderThickness="0,1,0,0">
   <DockPanel Margin="14,0">
    <TextBlock x:Name="StatusText" Text="Bereit" VerticalAlignment="Center" Foreground="#91A5B4"/>
    <TextBlock x:Name="DimensionsText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Ctrl+B → tmux" Foreground="#91A5B4"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
