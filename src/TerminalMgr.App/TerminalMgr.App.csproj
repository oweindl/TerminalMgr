<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/TerminalMgr.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TerminalMgr.Windows/TerminalMgr.Windows.csproj" />
    <!-- The updater is a separate small .NET Framework program: only built before this project, never referenced as a library. -->
    <ProjectReference Include="../TerminalMgr.Updater/TerminalMgr.Updater.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <Content Include="../TerminalMgr.Updater/bin/$(Configuration)/net48/TerminalMgr.Updater.exe" Link="TerminalMgr.Updater.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../TerminalMgr.Updater/bin/$(Configuration)/net48/TerminalMgr.Updater.exe.config" Link="TerminalMgr.Updater.exe.config" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <Resource Include="Assets/TerminalMgr.ico" />
    <Resource Include="Assets/TerminalMgr.png" />
    <Content Include="Terminal/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Integrations/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Whisper.net ships native libraries for every platform. Only those of the package's own Windows architecture are kept:
       x64 with CPU and Vulkan, arm64 and x86 with CPU only (there is no Vulkan build for them). -->
  <PropertyGroup>
    <KeepNative Condition="'$(RuntimeIdentifier)' == 'win-arm64'">win-arm64</KeepNative>
    <KeepNative Condition="'$(RuntimeIdentifier)' == 'win-x86'">win-x86</KeepNative>
    <KeepNative Condition="'$(KeepNative)' == ''">win-x64|vulkan[\\/]win-x64</KeepNative>
  </PropertyGroup>
  <Target Name="PruneForeignNativeRuntimes" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ForeignRuntimeFile Include="@(ResolvedFileToPublish)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[\\/](?!($(KeepNative))[\\/])'))" />
      <ResolvedFileToPublish Remove="@(ForeignRuntimeFile)" />
    </ItemGroup>
  </Target>
  <Target Name="CheckTerminalAssets" BeforeTargets="PrepareForBuild" Condition="!Exists('Terminal/vendor/xterm.js')">
    <Error Text="Terminal-Assets fehlen. Zuerst in web: npm ci und npm run bundle ausführen." />
  </Target>
</Project>
